---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getContent } from "../../data/site";

const content = getContent("tr");

const socialMeta = {
  X: {
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.26l-4.9-6.41L6.43 22H3.32l7.24-8.27L.8 2h6.42l4.43 5.85L18.9 2Zm-1.1 18h1.73L5.15 3.9H3.3Z"/></svg>`,
    hover: "group-hover:text-black group-hover:bg-black/10 group-hover:drop-shadow-[0_0_14px_rgba(15,23,42,0.3)] dark:group-hover:text-white dark:group-hover:bg-white/10 dark:group-hover:drop-shadow-[0_0_14px_rgba(255,255,255,0.24)]"
  },
  LinkedIn: {
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.94 8.5H3.56V20h3.38Zm.22-3.68C7.14 3.8 6.37 3 5.27 3S3.4 3.8 3.4 4.82c0 1 .75 1.82 1.84 1.82h.02c1.12 0 1.9-.81 1.9-1.82ZM20.6 12.55c0-3.03-1.62-4.44-3.78-4.44-1.74 0-2.52.96-2.96 1.63V8.5h-3.38c.05.83 0 11.5 0 11.5h3.38v-6.42c0-.34.03-.69.13-.93.27-.69.88-1.4 1.91-1.4 1.35 0 1.9 1.03 1.9 2.55V20H20.6Z"/></svg>`,
    hover: "group-hover:text-[#0077B5] group-hover:bg-[#0077B5]/10 group-hover:drop-shadow-[0_0_14px_rgba(0,119,181,0.42)]"
  },
  GitHub: {
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.6 2 12.26c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.5 0-.24-.01-1.03-.01-1.87-2.78.62-3.37-1.22-3.37-1.22-.45-1.2-1.12-1.52-1.12-1.52-.91-.64.07-.63.07-.63 1 .08 1.54 1.05 1.54 1.05.9 1.58 2.35 1.13 2.92.86.09-.67.35-1.13.63-1.4-2.22-.26-4.55-1.14-4.55-5.08 0-1.12.39-2.03 1.03-2.74-.1-.26-.45-1.3.1-2.72 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 7.8c.85 0 1.7.12 2.5.36 1.9-1.33 2.74-1.05 2.74-1.05.56 1.42.21 2.46.1 2.72.64.71 1.03 1.62 1.03 2.74 0 3.95-2.33 4.82-4.56 5.08.36.32.68.95.68 1.92 0 1.39-.01 2.5-.01 2.84 0 .28.18.61.69.5A10.16 10.16 0 0 0 22 12.26C22 6.6 17.52 2 12 2Z"/></svg>`,
    hover: "group-hover:text-[#171515] group-hover:bg-black/10 group-hover:drop-shadow-[0_0_14px_rgba(23,21,21,0.35)] dark:group-hover:text-white dark:group-hover:bg-white/10 dark:group-hover:drop-shadow-[0_0_14px_rgba(255,255,255,0.24)]"
  },
  Instagram: {
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2Zm0 1.8A3.95 3.95 0 0 0 3.8 7.75v8.5a3.95 3.95 0 0 0 3.95 3.95h8.5a3.95 3.95 0 0 0 3.95-3.95v-8.5a3.95 3.95 0 0 0-3.95-3.95Zm8.95 1.35a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2ZM12 6.86A5.14 5.14 0 1 1 6.86 12 5.15 5.15 0 0 1 12 6.86Zm0 1.8A3.34 3.34 0 1 0 15.34 12 3.35 3.35 0 0 0 12 8.66Z"/></svg>`,
    hover: "group-hover:text-[#E1306C] group-hover:bg-[#E1306C]/10 group-hover:drop-shadow-[0_0_14px_rgba(225,48,108,0.45)]"
  }
};

const cardIcons = {
  folder: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 7.5A2.5 2.5 0 0 1 5.5 5H10l2 2h6.5A2.5 2.5 0 0 1 21 9.5v7A2.5 2.5 0 0 1 18.5 19h-13A2.5 2.5 0 0 1 3 16.5Z"/></svg>`,
  pen: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 1 1 3 3L7 19l-4 1 1-4Z"/></svg>`,
  mail: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>`,
  music: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3a1 1 0 0 1 1 1v10.55A4 4 0 1 1 11 11V6.2l8-2v7.35A4 4 0 1 1 17 8V3.8l-6 1.5V11"/></svg>`,
  heart: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20s-6.5-4.35-8.5-8.1C1.86 8.88 3.4 5.5 6.9 5.5c2 0 3.16 1.08 4.1 2.28.94-1.2 2.1-2.28 4.1-2.28 3.5 0 5.04 3.38 3.4 6.4C18.5 15.65 12 20 12 20Z"/></svg>`,
  spark: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m12 3 1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9Z"/></svg>`,
  layers: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m12 3 9 4.5-9 4.5L3 7.5 12 3Z"/><path d="m3 12 9 4.5 9-4.5"/><path d="m3 16.5 9 4.5 9-4.5"/></svg>`
};
---
<BaseLayout title={content.meta.title} description={content.meta.description} lang="tr" footerText={content.footer.rights} social={content.social}>
  <div class="grid items-stretch gap-3 xl:grid-cols-[400px_minmax(0,1fr)]">
    <aside class="xl:sticky xl:top-4 xl:self-start">
      <div class="flex h-full flex-col overflow-hidden rounded-[2rem] border border-slate-200/80 bg-white/95 shadow-sm backdrop-blur-sm dark:border-slate-800 dark:bg-slate-900/95">
        <div class="h-72 overflow-hidden bg-slate-200 dark:bg-slate-800 xl:h-[325px]">
          <img src={content.profile.imageUrl} alt={content.profile.imageAlt} class="h-full w-full object-cover" />
        </div>
        <div class="flex flex-1 flex-col space-y-3 p-6 md:p-7">
          <div class="space-y-2">
            <h1 class="text-center font-display text-3xl font-semibold tracking-tight text-slate-950 dark:text-white">{content.profile.name}</h1>
            <p class="text-center font-display text-[13px] font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">{content.profile.role}</p>
          </div>
          <div class="flex justify-center pt-1">
            <div class="flex flex-wrap items-center justify-center gap-2.5 rounded-[1.6rem] bg-slate-50/95 px-3.5 py-2.5 ring-1 ring-slate-200 dark:bg-slate-800/90 dark:ring-slate-700">
              {content.social.map((item) => (
                <a href={item.href} target="_blank" rel="noreferrer" aria-label={item.label} class="group inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-white text-slate-700 shadow-sm ring-1 ring-slate-200 transition-all duration-200 hover:scale-[1.16] hover:shadow-md dark:bg-slate-900 dark:text-slate-300 dark:ring-slate-700">
                  <span class={`h-[18px] w-[18px] transition-all duration-200 ${socialMeta[item.label].hover}`} set:html={socialMeta[item.label].icon} />
                </a>
              ))}
            </div>
          </div>
          <p class="text-[15px] leading-6 text-slate-600 dark:text-slate-300">{content.profile.tagline}</p>
          <p class="text-sm leading-6 text-slate-500 dark:text-slate-400">{content.profile.summary}</p>
          <div class="mt-auto rounded-2xl bg-slate-50 px-4 py-3 text-sm text-slate-500 dark:bg-slate-800/80 dark:text-slate-400">{content.profile.location}</div>
        </div>
      </div>
    </aside>

    <div class="flex w-full flex-col space-y-3">
      <header class="flex flex-col gap-2.5 rounded-[2rem] border border-slate-200/80 bg-white/95 p-2.5 shadow-sm backdrop-blur-sm dark:border-slate-800 dark:bg-slate-900/95 md:flex-row md:items-center md:justify-between md:p-3">
        <nav class="flex flex-wrap items-center gap-2" aria-label="Primary navigation">
          <a href="#home" class="rounded-full bg-slate-950 px-5 py-2.5 font-display text-sm font-semibold text-white transition dark:bg-white dark:text-slate-950">{content.nav.home}</a>
          <span class="rounded-full border border-slate-200 px-5 py-2.5 font-display text-sm font-semibold text-slate-400 dark:border-slate-700 dark:text-slate-500">{content.nav.cv} · {content.nav.soon}</span>
          <span class="rounded-full border border-slate-200 px-5 py-2.5 font-display text-sm font-semibold text-slate-400 dark:border-slate-700 dark:text-slate-500">{content.nav.blog} · {content.nav.soon}</span>
        </nav>
        <div class="flex items-center gap-3">
          <div class="inline-flex rounded-full border border-slate-200 bg-slate-50 p-1 dark:border-slate-700 dark:bg-slate-800">
            <a href="/" class="rounded-full px-3 py-1.5 text-xs font-semibold text-slate-600 transition hover:text-slate-950 dark:text-slate-300 dark:hover:text-white">EN</a>
            <span class="rounded-full bg-slate-950 px-3 py-1.5 text-xs font-semibold text-white dark:bg-white dark:text-slate-950">TR</span>
          </div>
          <button type="button" data-theme-toggle aria-pressed="false" class="group relative inline-flex h-11 w-11 items-center justify-center rounded-full border border-slate-200 bg-slate-50 text-slate-700 transition hover:-translate-y-0.5 hover:shadow-md dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
            <span class="sr-only">Toggle theme</span>
            <svg class="h-5 w-5 transition-opacity duration-200 group-data-[theme=dark]:opacity-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2.5M12 19.5V22M4.93 4.93l1.77 1.77M17.3 17.3l1.77 1.77M2 12h2.5M19.5 12H22M4.93 19.07l1.77-1.77M17.3 6.7l1.77-1.77"></path></svg>
            <svg class="absolute h-5 w-5 opacity-0 transition-opacity duration-200 group-data-[theme=dark]:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path></svg>
          </button>
        </div>
      </header>

      <section id="home" class="mx-auto grid auto-rows-[minmax(110px,auto)] grid-cols-1 gap-2.5 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-3">
        <div class="group rounded-[2rem] border border-slate-200/80 bg-white/95 p-6 shadow-sm backdrop-blur-sm transition-all hover:-translate-y-1 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/95 md:col-span-2 xl:col-span-3">
          <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500">{content.home.label}</p>
          <h2 class="max-w-2xl font-display text-[1.58rem] font-semibold leading-tight tracking-tight text-slate-950 dark:text-white md:text-[1.9rem]">{content.home.heroTitle}</h2>
          <p class="mt-1.5 max-w-2xl text-sm leading-5.5 text-slate-600 dark:text-slate-300">{content.home.heroDescription}</p>
          <div class="mt-2.5 flex flex-wrap items-center gap-2">
            <span class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">{content.home.focusTitle}</span>
            {content.home.focusItems.map((item) => (
              <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-medium text-slate-600 ring-1 ring-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:ring-slate-700">{item}</span>
            ))}
          </div>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:col-span-3 md:grid-cols-[1.2fr_1fr_1fr]">
          {content.home.cards.map((card) => (
          <a href={card.href || "#"} class={`group min-h-[208px] rounded-[2rem] border border-slate-200/80 bg-slate-50/95 p-6 shadow-sm backdrop-blur-sm transition-all hover:-translate-y-1 hover:shadow-md dark:border-slate-800 dark:bg-slate-800/90 ${card.span || ""}`}>
            <div class="flex h-full flex-col items-start justify-start gap-5 text-left">
              <div class="flex w-full items-center justify-between gap-4">
                <h3 class="font-display text-lg font-semibold tracking-tight text-slate-950 dark:text-white md:text-[1.15rem]">{card.title}</h3>
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center self-start rounded-2xl bg-white text-slate-700 ring-1 ring-slate-200 transition group-hover:bg-slate-950 group-hover:text-white dark:bg-slate-900 dark:text-slate-200 dark:ring-slate-700 dark:group-hover:bg-white dark:group-hover:text-slate-950"><span class="flex h-5 w-5 items-center justify-center" set:html={cardIcons[card.icon]} /></span>
              </div>
              <p class="max-w-md text-sm leading-5.5 text-slate-600 dark:text-slate-300">{card.description}</p>
            </div>
          </a>
          ))}
        </div>
        <a href={content.home.contact.href || "#"} class={`group min-h-[88px] md:col-span-3 md:w-full rounded-[2rem] border border-slate-200/80 bg-slate-50/95 p-6 shadow-sm backdrop-blur-sm transition-all hover:-translate-y-1 hover:shadow-md dark:border-slate-800 dark:bg-slate-800/90 ${content.home.contact.span || ""}`}>
          <div class="flex h-full flex-col justify-between gap-3 md:flex-row md:items-center md:justify-between">
            <div class="max-w-xl">
              <p class="mb-1.5 text-[11px] font-semibold uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500">{content.home.contact.eyebrow}</p>
              <h3 class="font-display text-lg font-semibold tracking-tight text-slate-950 dark:text-white md:text-[1.15rem]">{content.home.contact.title}</h3>
              <p class="mt-1.5 text-sm leading-5.5 text-slate-600 dark:text-slate-300">{content.home.contact.description}</p>
            </div>
            <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-white text-slate-700 ring-1 ring-slate-200 transition group-hover:bg-slate-950 group-hover:text-white dark:bg-slate-900 dark:text-slate-200 dark:ring-slate-700 dark:group-hover:bg-white dark:group-hover:text-slate-950"><span class="flex h-5 w-5 items-center justify-center" set:html={cardIcons[content.home.contact.icon]} /></span>
          </div>
        </a>
      </section>
    </div>
  </div>
</BaseLayout>
