---
import "../styles/global.css";

const { title, description, lang = "en", footerText = "", social = [] } = Astro.props;
const isEn = lang === "en";
const altHref = isEn ? "/tr/" : "/";
const altLang = isEn ? "tr" : "en";
const canonicalPath = isEn ? "/" : "/tr/";
const canonicalUrl = new URL(canonicalPath, Astro.site);
const alternateUrl = new URL(altHref, Astro.site);

const iconMap = {
  X: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.26l-4.9-6.41L6.43 22H3.32l7.24-8.27L.8 2h6.42l4.43 5.85L18.9 2Zm-1.1 18h1.73L5.15 3.9H3.3Z"/></svg>`,
  LinkedIn: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.94 8.5H3.56V20h3.38Zm.22-3.68C7.14 3.8 6.37 3 5.27 3S3.4 3.8 3.4 4.82c0 1 .75 1.82 1.84 1.82h.02c1.12 0 1.9-.81 1.9-1.82ZM20.6 12.55c0-3.03-1.62-4.44-3.78-4.44-1.74 0-2.52.96-2.96 1.63V8.5h-3.38c.05.83 0 11.5 0 11.5h3.38v-6.42c0-.34.03-.69.13-.93.27-.69.88-1.4 1.91-1.4 1.35 0 1.9 1.03 1.9 2.55V20H20.6Z"/></svg>`,
  GitHub: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.6 2 12.26c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.5 0-.24-.01-1.03-.01-1.87-2.78.62-3.37-1.22-3.37-1.22-.45-1.2-1.12-1.52-1.12-1.52-.91-.64.07-.63.07-.63 1 .08 1.54 1.05 1.54 1.05.9 1.58 2.35 1.13 2.92.86.09-.67.35-1.13.63-1.4-2.22-.26-4.55-1.14-4.55-5.08 0-1.12.39-2.03 1.03-2.74-.1-.26-.45-1.3.1-2.72 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 7.8c.85 0 1.7.12 2.5.36 1.9-1.33 2.74-1.05 2.74-1.05.56 1.42.21 2.46.1 2.72.64.71 1.03 1.62 1.03 2.74 0 3.95-2.33 4.82-4.56 5.08.36.32.68.95.68 1.92 0 1.39-.01 2.5-.01 2.84 0 .28.18.61.69.5A10.16 10.16 0 0 0 22 12.26C22 6.6 17.52 2 12 2Z"/></svg>`,
  Instagram: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2Zm0 1.8A3.95 3.95 0 0 0 3.8 7.75v8.5a3.95 3.95 0 0 0 3.95 3.95h8.5a3.95 3.95 0 0 0 3.95-3.95v-8.5a3.95 3.95 0 0 0-3.95-3.95Zm8.95 1.35a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2ZM12 6.86A5.14 5.14 0 1 1 6.86 12 5.15 5.15 0 0 1 12 6.86Zm0 1.8A3.34 3.34 0 1 0 15.34 12 3.35 3.35 0 0 0 12 8.66Z"/></svg>`
};

const themeScript = `(() => {
  const storageKey = "theme";
  const root = document.documentElement;
  const getPreferred = () => window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  const setTheme = (theme) => {
    root.classList.toggle("dark", theme === "dark");
    root.dataset.theme = theme;
    root.style.colorScheme = theme;
    localStorage.setItem(storageKey, theme);
  };
  setTheme(localStorage.getItem(storageKey) || getPreferred());
  window.__toggleTheme = () => {
    const current = root.dataset.theme || getPreferred();
    setTheme(current === "dark" ? "light" : "dark");
  };
})();`;

const toggleScript = `(() => {
  const button = document.querySelector("[data-theme-toggle]");
  if (!button) return;
  const update = () => {
    const theme = document.documentElement.dataset.theme || "light";
    const dark = theme === "dark";
    button.setAttribute("aria-pressed", dark ? "true" : "false");
    button.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
    button.dataset.theme = theme;
  };
  update();
  button.addEventListener("click", () => {
    if (window.__toggleTheme) window.__toggleTheme();
    update();
  });
})();`;
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" href={alternateUrl} hreflang={altLang} />
    <link rel="alternate" href={canonicalUrl} hreflang={lang} />
    <link rel="alternate" href={canonicalUrl} hreflang="x-default" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <script is:inline set:html={themeScript}></script>
  </head>
  <body class="min-h-screen bg-slate-100 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <div class="pointer-events-none fixed inset-0 -z-10 bg-[#eff3f6] dark:bg-[#111827]"></div>
    <div class="pointer-events-none fixed inset-0 -z-10 opacity-100 blur-[0.75px] [background-image:repeating-linear-gradient(-45deg,rgba(244,248,250,0.97)_0,rgba(244,248,250,0.97)_138px,rgba(239,244,247,0.96)_138px,rgba(239,244,247,0.96)_232px,rgba(235,241,245,0.92)_232px,rgba(235,241,245,0.92)_396px,rgba(241,245,248,0.95)_396px,rgba(241,245,248,0.95)_516px,rgba(236,242,246,0.92)_516px,rgba(236,242,246,0.92)_708px)] dark:[background-image:repeating-linear-gradient(-45deg,rgba(18,24,37,0.935)_0,rgba(18,24,37,0.935)_136px,rgba(19,26,40,0.93)_136px,rgba(19,26,40,0.93)_228px,rgba(21,28,42,0.915)_228px,rgba(21,28,42,0.915)_386px,rgba(18,25,38,0.932)_386px,rgba(18,25,38,0.932)_504px,rgba(20,27,41,0.918)_504px,rgba(20,27,41,0.918)_692px)]"></div>
    <div class="mx-auto max-w-[1240px] px-5 py-8 md:px-7 md:py-9 xl:px-10 xl:py-10">
      <slot />
      <footer class="mt-6 border-t border-slate-200/80 pt-4 dark:border-slate-800">
        <div class="flex flex-col items-center gap-3 text-center">
          <p class="text-sm text-slate-500 dark:text-slate-400">{footerText}</p>
          <div class="flex items-center gap-3 text-slate-400 dark:text-slate-600">
            {social.map((item) => (
              <a href={item.href} target="_blank" rel="noreferrer" aria-label={item.label} class="transition-colors hover:text-slate-500 dark:hover:text-slate-400">
                <span class="block h-3.5 w-3.5" set:html={iconMap[item.label]} />
              </a>
            ))}
          </div>
        </div>
      </footer>
    </div>
    <script is:inline set:html={toggleScript}></script>
  </body>
</html>
